# GKE Configuration Template
# Copy this file to gke-config.env and fill in your values
# Usage: source gke-config.env

# ============================================
# GCP Project Configuration
# ============================================
export GCP_PROJECT_ID="flask-k8s-production"  # Your GCP project ID
export GCP_REGION="asia-south1"               # GCP region for resources (Mumbai, India)
export GCP_ZONE="asia-south1-a"               # GCP zone for GKE cluster

# ============================================
# Artifact Registry Configuration
# ============================================
export REPOSITORY_NAME="flask-app-images"     # Artifact Registry repository name
export REGISTRY_URL="${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT_ID}/${REPOSITORY_NAME}"

# ============================================
# GKE Cluster Configuration
# ============================================
export CLUSTER_NAME="flask-k8s-cluster"       # GKE cluster name
export CLUSTER_ZONE="${GCP_ZONE}"             # Cluster zone
export NODE_COUNT="2"                         # Number of nodes
export MACHINE_TYPE="e2-medium"               # Node machine type

# ============================================
# Application Configuration
# ============================================
export IMAGE_TAG="latest"                     # Docker image tag (or use: $(git rev-parse --short HEAD))
export KUBE_NAMESPACE="flask-app"             # Kubernetes namespace
export BACKEND_REPLICAS="2"                   # Backend pod replicas
export FRONTEND_REPLICAS="2"                  # Frontend pod replicas

# ============================================
# Domain Configuration (Optional)
# ============================================
export APP_DOMAIN="flask-app.example.com"     # Your domain name (change this!)
export ENABLE_HTTPS="false"                   # Set to "true" for SSL/TLS

# ============================================
# GitLab CI/CD Configuration
# ============================================
# Note: These should be set as GitLab CI/CD variables in your project
# Settings → CI/CD → Variables
#
# Required variables:
# - GCP_SERVICE_KEY (base64 encoded service account key - masked & protected)
# - GCP_PROJECT_ID
# - GCP_REGION
# - GCP_ZONE
# - ARTIFACT_REGISTRY_REPO
# - GKE_CLUSTER_NAME
# - KUBE_NAMESPACE

# ============================================
# Helper Functions
# ============================================

# Print current configuration
print_config() {
    echo "=========================================="
    echo "GKE Configuration"
    echo "=========================================="
    echo "Project ID:      $GCP_PROJECT_ID"
    echo "Region:          $GCP_REGION"
    echo "Zone:            $GCP_ZONE"
    echo "Cluster:         $CLUSTER_NAME"
    echo "Namespace:       $KUBE_NAMESPACE"
    echo "Registry URL:    $REGISTRY_URL"
    echo "Image Tag:       $IMAGE_TAG"
    echo "Domain:          $APP_DOMAIN"
    echo "=========================================="
}

# Verify configuration
verify_config() {
    echo "Verifying configuration..."
    
    # Check gcloud project
    CURRENT_PROJECT=$(gcloud config get-value project 2>/dev/null)
    if [ "$CURRENT_PROJECT" != "$GCP_PROJECT_ID" ]; then
        echo "⚠️  Warning: gcloud project ($CURRENT_PROJECT) doesn't match GCP_PROJECT_ID ($GCP_PROJECT_ID)"
        echo "Run: gcloud config set project $GCP_PROJECT_ID"
    else
        echo "✓ GCP project matches"
    fi
    
    # Check cluster exists
    if gcloud container clusters describe $CLUSTER_NAME --zone=$GCP_ZONE --project=$GCP_PROJECT_ID &>/dev/null; then
        echo "✓ GKE cluster exists"
    else
        echo "⚠️  Warning: GKE cluster '$CLUSTER_NAME' not found in zone $GCP_ZONE"
    fi
    
    # Check Artifact Registry repository
    if gcloud artifacts repositories describe $REPOSITORY_NAME --location=$GCP_REGION --project=$GCP_PROJECT_ID &>/dev/null; then
        echo "✓ Artifact Registry repository exists"
    else
        echo "⚠️  Warning: Artifact Registry repository '$REPOSITORY_NAME' not found in $GCP_REGION"
    fi
}

# Quick commands
alias gke-connect="gcloud container clusters get-credentials $CLUSTER_NAME --zone=$CLUSTER_ZONE --project=$GCP_PROJECT_ID"
alias gke-status="kubectl get all -n $KUBE_NAMESPACE"
alias gke-logs-backend="kubectl logs -n $KUBE_NAMESPACE -l app=flask-backend -f"
alias gke-logs-frontend="kubectl logs -n $KUBE_NAMESPACE -l app=flask-frontend -f"
alias gke-pods="kubectl get pods -n $KUBE_NAMESPACE"
alias gke-ingress="kubectl get ingress -n $KUBE_NAMESPACE"

# Print aliases
echo ""
echo "Available aliases:"
echo "  gke-connect        - Connect to GKE cluster"
echo "  gke-status         - Show all resources in namespace"
echo "  gke-logs-backend   - Follow backend logs"
echo "  gke-logs-frontend  - Follow frontend logs"
echo "  gke-pods           - Show pods"
echo "  gke-ingress        - Show ingress"
echo ""
echo "Run 'print_config' to see your configuration"
echo "Run 'verify_config' to verify your setup"
echo ""
